// Cloudflare deployment of your own Rondel: `npm run cf:deploy` (see DEPLOY.md).
// It deploys a Worker called "rondel" to rondel.<your-subdomain>.workers.dev. For your own domain, add
// "routes": [{ "pattern": "rondel.example.com", "custom_domain": true }], or copy this file into your
// deploy/<you>/ folder as deploy/spikinglabs/ does.
// The same app also runs on any Node host (server/node) or as static files with peer-to-peer sync.
{
  "name": "rondel",
  "main": "server/cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Meetings are deleted from the server this many days after their last change ("0": never).
  "vars": { "RETENTION_DAYS": "90" },
  // Meeting connections per network address per minute. A whole office can share one address, so this
  // only stops scripts. namespace_id is any number unique within the account.
  "ratelimits": [{ "name": "CONNECT_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }]
}
